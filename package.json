{
  "name": "hollowspire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/run.ts",
    "sim:day": "tsx src/sim/long.ts",
    "sim:week": "tsx src/sim/week.ts",
    "smoke": "node scripts/smoke.mjs",
    "playthrough": "node scripts/playthrough.mjs",
    "cap:sync": "cap sync",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "build:single": "node scripts/singlefile.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron/packager": "^18.4.4",
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^24.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  },
  "description": "A tap-and-idle crafting game about growing one great tree.",
  "author": "Hollowspire",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hollowspire.game",
    "productName": "Hollowspire",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "Hollowspire-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Hollowspire-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Hollowspire-${version}-portable.${ext}"
    }
  }
}
